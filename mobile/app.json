{
  "expo": {
    "name": "لوحة تحكم السعودية",
    "slug": "saudi-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "saudimobileapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#006C35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.gov.saudidashboard.mobile",
      "infoPlist": {
        "CFBundleDisplayName": "لوحة تحكم السعودية",
        "CFBundleLocalizations": ["ar", "en"],
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "package": "sa.gov.saudidashboard.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#006C35"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-localization"
    ]
  }
}
