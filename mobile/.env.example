# Copy to .env and adjust for your setup, or export these in your shell before
# running `npx expo start`. Expo only inlines vars prefixed EXPO_PUBLIC_.

# Point this at your machine's LAN IP when testing on a physical device via
# Expo Go, since the phone can't resolve "localhost" as your dev machine.
# The Android emulator, iOS simulator, and web already have sane defaults
# baked into config/api.config.ts (10.0.2.2 / localhost), so this is only
# needed for a physical device.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8080/api
